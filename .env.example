# Copy this file to .env and fill in real values.
# Never commit .env — it is already listed in .gitignore.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# API metadata (returned by GET /api/supporthub-ai/version)
# ---------------------------------------------------------------------------
API_VERSION=1.0.0
PROMPT_VERSION=v1

# ---------------------------------------------------------------------------
# AI provider
# Primary provider is Groq; Gemini is used as an automatic fallback if the
# Groq call fails. Both keys are required for the fallback to work.
# ---------------------------------------------------------------------------
AI_PROVIDER=groq
AI_TIMEOUT=30000
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# Request limits
# ---------------------------------------------------------------------------
MAX_INPUT_LENGTH=2000

# ---------------------------------------------------------------------------
# CORS
# Comma-separated list of origins allowed to call this API from a browser.
# Must match the origin the frontend is actually served from
# (Vite's default dev server is http://localhost:5173).
# ---------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# PostgreSQL
# Run tables.sql against this database once before starting the server.
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=supporthub
