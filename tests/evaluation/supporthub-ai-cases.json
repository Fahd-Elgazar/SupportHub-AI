{
  "schema_version": "1.0",
  "description": "Evaluation cases for SupportHub AI grounded responses, source traceability, safety behavior, and ticket classification.",
  "tests": [
    {
      "id": "AI-001",
      "name": "Password reset question",
      "input": {
        "message": "How can I reset my password?"
      },
      "expected": {
        "result": "grounded_answer",
        "answer_contains": [
          "Forgot Password",
          "registered email address"
        ],
        "source_ids": [
          "KB-FAQ-001"
        ],
        "classification": {
          "category": "account_access",
          "impact": "low",
          "urgency": "low",
          "security_flag": false,
          "service_outage_flag": false,
          "manual_review_required": false
        }
      }
    },
